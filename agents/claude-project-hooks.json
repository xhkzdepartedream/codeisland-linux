{
  "_comment": "Shape of the hooks this project installs into a *project-scoped* .claude/settings.json. The bridge is spawned once per event and must always be given --source claude. Automatic installation into the global ~/.claude/settings.json is deliberately NOT implemented yet -- see docs/与上游的差异.md for the known failure mode where Claude Code regenerates that file and drops injected hooks. Replace BRIDGE_PATH with the absolute path to target/release/codeisland-bridge.",

  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "BRIDGE_PATH --source claude", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "BRIDGE_PATH --source claude", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "BRIDGE_PATH --source claude", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "BRIDGE_PATH --source claude", "timeout": 10 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "BRIDGE_PATH --source claude", "timeout": 3600 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "BRIDGE_PATH --source claude", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "BRIDGE_PATH --source claude", "timeout": 10 }
        ]
      }
    ]
  }
}
