// Bottom layer of the blur experiment: an opaque, static, high-frequency
// checkerboard band across the top of the screen.
//
// It exists so the measurement needs only ONE screenshot. Comparing the noise
// seen *through* the pill against the same noise seen *directly*, side by side in
// a single capture, removes the need to diff two captures of a live desktop --
// which is what made the first attempt void (the panel clock and this agent's own
// terminal output both changed between captures).
//
// The pattern is generated by gen-noise.py, deterministic from seed 1234.

import QtQuick
import QtQuick.Window
import org.kde.layershell as LS

Window {
    id: root
    visible: true
    width: Screen.width
    height: 520
    title: "codeisland-blur-backdrop"
    color: "#ff000000"

    LS.Window.layer: LS.Window.LayerTop
    LS.Window.anchors: LS.Window.AnchorTop | LS.Window.AnchorLeft | LS.Window.AnchorRight
    LS.Window.exclusionZone: -1
    LS.Window.keyboardInteractivity: LS.Window.KeyboardInteractivityNone

    Image {
        id: noise
        anchors.fill: parent
        // Tile rather than crop: PreserveAspectCrop stretched a 1600px pattern
        // across a 3456px surface and the harness cannot tell a resampled
        // checkerboard from a blurred one. Tiling keeps the cell size known.
        fillMode: Image.Tile
        property string source_path: "file:///tmp/ci-blur2/noise.png"
        source: source_path
        asynchronous: false
        cache: false
    }

    Timer {
        interval: 20000
        running: true
        repeat: false
        onTriggered: Qt.exit(0)
    }
}
